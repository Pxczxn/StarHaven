# 复制为 .env.development 后按需修改
# cp env/.env.example env/.env.development

# 应用
VITE_APP_TITLE=星栖 StarHaven
VITE_APP_PORT=5566
VITE_APP_PUBLIC_BASE=/
VITE_APP_ROUTER_MODE=history
VITE_FALLBACK_LOCALE=zh-Hans
VITE_DELETE_CONSOLE=false

# 后端 API（StarHaven 服务端默认 5567）
VITE_SERVER_BASEURL=http://127.0.0.1:5567
VITE_SERVER_HAS_API_PREFIX=false

# H5 开发代理（避免跨域，同时代理 /houses、/banners 静态资源）
VITE_APP_PROXY_ENABLE=true
VITE_APP_PROXY_PREFIX=/fg-api

# 认证：后端为单 token，务必使用 single
VITE_AUTH_MODE=single

# 微信小程序（开发者工具请填局域网 IP，不要用 localhost）
VITE_UNI_APPID=
VITE_WX_APPID=
VITE_SERVER_BASEURL__WEIXIN_DEVELOP=http://127.0.0.1:5567
VITE_SERVER_BASEURL__WEIXIN_TRIAL=
VITE_SERVER_BASEURL__WEIXIN_RELEASE=

# App 原生资源复制（仅 app 平台需要时开启）
VITE_COPY_NATIVE_RES_ENABLE=false
