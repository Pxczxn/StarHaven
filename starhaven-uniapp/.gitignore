# ============================================================
# 原则：只提交项目源码 + 正式插图；其余忽略
#
# 插图 vs 原型图：只按路径判断
# 插图路径（提交）：public/images/、public/brand/、src/assets/、static/
# 原型路径（忽略）：.prototype-review/、prototype-assets/、prototype-specs/
# ============================================================

# 依赖
node_modules/

# 构建产物
dist/
*.tsbuildinfo

# 缓存与测试输出
.cache/
coverage/
playwright-report/
test-results/
.eslintcache
.stylelintcache

# 运行时与临时文件
.logs/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local
*.pid
*.tmp

# 本地环境与密钥
.env
.env.*
!.env.example
!env/.env.example

# IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.hbuilderx/

# AI / Agent 产出
.agents/
.agent/
.codex/
.claude/
.cursor/
.ai/
hermes/
rollout-*.jsonl
.codex-*.png

# 原型路径（忽略）
.prototype-review/
prototype/
prototypes/
prototype-specs/
prototype-assets/
mockup/
wireframe/
figma/
design/

# 非插图路径的根目录截图（不覆盖 src/static/）
/*.png
/*.jpg
/*.jpeg
/*.webp

# 开发资料（限定顶层，避免误伤 src/ 下的同名源码目录，如 src/http/tools/）
/docs/
/doc/
*.md
!/README.md
/qa/
/tools/

# uni-app 生成文件（由 manifest.config.ts / pages.config.ts 生成）
src/types
!src/types/auto-import.d.ts
src/manifest.json
src/pages.json

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini
